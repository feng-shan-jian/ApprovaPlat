    </description>

    <dependencies>

        <!-- 通用工具-->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-common</artifactId>
        </dependency>

        <!-- 外部短信与 OSS 台账使用受控 JDBC 事务，不引入旧版供应商 SDK 的 Jackson 2 运行时。 -->
