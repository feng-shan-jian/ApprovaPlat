<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="https://approvaplat.example/flowable/integration-test">
  <process id="flowableTimerIntegration" name="Flowable 定时任务集成测试" isExecutable="true">
    <startEvent id="start"/>
    <sequenceFlow id="toTimer" sourceRef="start" targetRef="waitForTimer"/>
    <intermediateCatchEvent id="waitForTimer" name="等待定时触发">
      <timerEventDefinition>
        <timeDuration>PT5S</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>
    <sequenceFlow id="toEnd" sourceRef="waitForTimer" targetRef="end"/>
    <endEvent id="end"/>
  </process>
</definitions>
