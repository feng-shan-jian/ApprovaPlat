<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.ruoyi</groupId>
        <artifactId>ruoyi</artifactId>
        <version>3.9.2</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>ruoyi-flowable</artifactId>
    <description>工作流引擎与审批业务模块</description>

    <dependencies>
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-system</artifactId>
        </dependency>

        <!-- 领域服务复用统一实时权限源，避免旧 Token 快照绕过工作流细粒度撤权。 -->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-framework</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-spring-boot-starter-process</artifactId>
        </dependency>

        <!-- BusinessRuleTask 部署后由官方 Flowable DMN 引擎执行冻结决策。 -->
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-spring-boot-starter-dmn</artifactId>
        </dependency>
        <!-- Process Engine 通过该官方 Configurator 执行同部署冻结的 DMN 决策。 -->
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-dmn-engine-configurator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-dmn-spring-configurator</artifactId>
        </dependency>

        <!-- 受控 SQL 连接器通过 SQL AST 校验单语句和命名参数模板。 -->
        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
        </dependency>

        <!-- CEL 仅作为受控表达式编译器和运行时使用，不加载网络、文件或 Spring 扩展。 -->
        <dependency>
            <groupId>dev.cel</groupId>
            <artifactId>cel</artifactId>
            <version>${cel.version}</version>
        </dependency>

        <!-- 工作流运行健康和业务指标由应用的受控 Actuator 端点统一发布。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-health</artifactId>
        </dependency>

        <!-- 动态邮件发送器复用 Jakarta Mail；SMTP 字段和加密凭据只从 sys_mail_config 读取。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>

        <!-- 工作流 JSON 变量、模型元数据和表单快照统一使用 Jackson 3。 -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 终止执行树集成测试使用官方 Flowable 引擎和内存 H2，不依赖生产数据库。 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 多实例轮次约束和并发 CAS 必须在真实 MySQL 8 上验证，H2 不代替该验收层。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            真实 MySQL 验收只在显式 profile 下由 Failsafe 执行，普通 test/verify 不连接数据库。
            CI 命令：mvn -pl ruoyi-flowable -am -Pworkflow-mysql-it verify
        -->
        <profile>
            <id>workflow-mysql-it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>require-workflow-mysql-it-environment</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireProperty>
                                            <property>env.WORKFLOW_MYSQL_TEST_URL</property>
                                            <regex>jdbc:mysql:.*</regex>
                                            <message>workflow-mysql-it 必须显式配置隔离 MySQL JDBC URL。</message>
                                        </requireProperty>
                                        <requireProperty>
                                            <property>env.WORKFLOW_MYSQL_TEST_USERNAME</property>
                                            <regex>.+</regex>
                                            <message>workflow-mysql-it 必须显式配置隔离 MySQL 用户名。</message>
                                        </requireProperty>
                                        <requireProperty>
                                            <property>env.WORKFLOW_MYSQL_TEST_PASSWORD</property>
                                            <message>workflow-mysql-it 必须显式配置隔离 MySQL 密码。</message>
                                        </requireProperty>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.5.4</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <includes>
                                <include>**/*IT.java</include>
                            </includes>
                            <failIfNoTests>true</failIfNoTests>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
