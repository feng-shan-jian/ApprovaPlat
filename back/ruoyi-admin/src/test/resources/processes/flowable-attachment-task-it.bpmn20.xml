<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="https://approvaplat.example/flowable/attachment-task-integration-test">
  <process id="flowableAttachmentTaskIntegration"
           name="工作流附件任务闭环集成测试"
           isExecutable="true">
    <startEvent id="start" name="发起申请"
                flowable:formKey="key_p14_start_form"
                flowable:initiator="initiator"/>
    <sequenceFlow id="toReview" sourceRef="start" targetRef="review"/>
    <userTask id="review" name="审核附件"
              flowable:formKey="key_p14_review_form"
              flowable:assignee="${initiator}"/>
    <sequenceFlow id="toConfirm" sourceRef="review" targetRef="confirm"/>
    <userTask id="confirm" name="确认归档"
              flowable:formKey="key_p14_confirm_form"
              flowable:assignee="${initiator}"/>
    <sequenceFlow id="toEnd" sourceRef="confirm" targetRef="end"/>
    <endEvent id="end"/>
  </process>
</definitions>
