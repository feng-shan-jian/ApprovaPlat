<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.flowable.mapper.WorkflowRuntimeTaskMapper">

    <select id="selectActiveTaskRevision" resultType="java.lang.Integer">
        select REV_
        from ACT_RU_TASK
        where ID_ = #{taskId}
    </select>

</mapper>
