    {
      "modelKey": "sample_leave_approval",
      "modelName": "请假申请",
      "description": "员工请假由部门负责人审核，再由总经理审批。",
      "category": { "code": "sample_hr", "name": "人事审批" },
      "formName": "请假申请表",
      "form": {
        "labelPosition": "right",
        "labelWidth": 110,
        "size": "default",
        "gutter": 16,
        "fields": [
          {
            "__vModel__": "leaveType",
            "__config__": { "layout": "colFormItem", "tag": "el-select", "label": "请假类型", "span": 12, "required": true },
            "placeholder": "请选择请假类型",
            "clearable": true,
            "__slot__": { "options": [
              { "label": "年假", "value": "annual" },
              { "label": "事假", "value": "personal" },
              { "label": "病假", "value": "sick" }
            ] }
          },
          {
            "__vModel__": "leaveRange",
            "__config__": { "layout": "colFormItem", "tag": "el-date-picker", "label": "请假日期", "span": 12, "required": true },
            "type": "daterange",
            "value-format": "YYYY-MM-DD",
            "range-separator": "至",
            "start-placeholder": "开始日期",
            "end-placeholder": "结束日期"
          },
          {
            "__vModel__": "leaveReason",
            "__config__": { "layout": "colFormItem", "tag": "el-input", "label": "请假事由", "span": 24, "required": true },
            "type": "textarea",
            "rows": 4,
            "maxlength": 500,
            "show-word-limit": true,
            "placeholder": "请输入请假事由"
          }
        ]
      },
      "tasks": [
        { "id": "department_review", "name": "部门负责人审核", "identityType": "role", "identityKey": "company_department_manager" },
        { "id": "general_manager_review", "name": "总经理审批", "identityType": "role", "identityKey": "company_general_manager" }
      ]
    },
