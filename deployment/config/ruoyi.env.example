# 复制到 /etc/ruoyi/ruoyi.env 后由 root 填写真实值并设置权限 0600。
# 该示例只能保存变量名和非敏感默认值，禁止写入任何真实凭据。
RUOYI_DB_URL=jdbc:mysql://127.0.0.1:3306/ry-vue?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia%2FShanghai
RUOYI_DB_USERNAME=ruoyi_app
RUOYI_DB_PASSWORD=
RUOYI_TOKEN_SECRET=
RUOYI_BOOTSTRAP_ADMIN_ENABLED=false
RUOYI_BOOTSTRAP_ADMIN_PASSWORD=
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_DATABASE=0
SPRING_DATA_REDIS_USERNAME=default
SPRING_DATA_REDIS_PASSWORD=
# 远程 Redis 使用 TLS 时设为 true，并在系统信任库中安装批准的 CA。
SPRING_DATA_REDIS_SSL_ENABLED=false
DRUID_MONITOR_USERNAME=ruoyi
DRUID_MONITOR_PASSWORD=
DRUID_MONITOR_ENABLED=false
RUOYI_LOG_PATH=/var/lib/ruoyi/logs
RUOYI_PROFILE=/var/lib/ruoyi/uploadPath
RUOYI_MANAGEMENT_PORT=18080
# 生产运行拓扑和容量引用均为非敏感值，但必须替换为本次真实批准结果。
FLOWABLE_RUNTIME_DEPLOYMENT_TOPOLOGY=SINGLE_NODE
FLOWABLE_RUNTIME_EXECUTOR_TOPOLOGY=DISABLED
FLOWABLE_RUNTIME_NODE_ID=workflow-node-01
FLOWABLE_RUNTIME_APPROVAL_REFERENCE=
FLOWABLE_RUNTIME_CAPACITY_APPROVAL_REFERENCE=
FLOWABLE_ASYNC_EXECUTOR_ACTIVATE=false
FLOWABLE_ASYNC_HISTORY_EXECUTOR_ACTIVATE=false
FLOWABLE_ATTACHMENT_STORAGE_MODE=LOCAL_PERSISTENT
# SHARED_FILESYSTEM 模式必须填写预置 .storage-id 的真实值；本地持久卷保持为空。
FLOWABLE_ATTACHMENT_STORAGE_ID=
FLOWABLE_ATTACHMENT_CLEANUP_LOCK_MODE=MYSQL_ADVISORY
FLOWABLE_ATTACHMENT_CLEANUP_LOCK_NAME=approvaplat:wf-attachment-cleanup
FLOWABLE_ATTACHMENT_MAX_SIZE=52428800
FLOWABLE_ATTACHMENT_MAX_TEMPORARY_COUNT=100
FLOWABLE_ATTACHMENT_MAX_TEMPORARY_BYTES=536870912
FLOWABLE_ATTACHMENT_MAX_TOTAL_BYTES=53687091200
FLOWABLE_ATTACHMENT_MIN_FREE_BYTES=1073741824
FLOWABLE_ATTACHMENT_CLEANUP_BATCH_SIZE=100
FLOWABLE_ATTACHMENT_CLEANUP_RETRY_INITIAL_DELAY=PT1M
FLOWABLE_ATTACHMENT_CLEANUP_RETRY_MAX_DELAY=PT6H
FLOWABLE_ATTACHMENT_CLEANUP_INITIAL_DELAY=PT1M
FLOWABLE_ATTACHMENT_CLEANUP_FIXED_DELAY=PT10M
FLOWABLE_RUNTIME_METRICS_REFRESH_INITIAL_DELAY=PT10S
FLOWABLE_RUNTIME_METRICS_REFRESH_INTERVAL=PT1M
FLOWABLE_RUNTIME_METRICS_SNAPSHOT_MAX_AGE=PT3M
