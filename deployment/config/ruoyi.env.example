# 复制到 /etc/ruoyi/ruoyi.env 后由 root 填写真实值并设置权限 0600。
# 该示例只能保存变量名和非敏感默认值，禁止写入任何真实凭据。
RUOYI_DB_URL=jdbc:mysql://127.0.0.1:3306/ry-vue?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia%2FShanghai
RUOYI_DB_USERNAME=ruoyi_app
RUOYI_DB_PASSWORD=
# 可选：留空时应用会在 RUOYI_TOKEN_SECRET_FILE 指向的私有文件中自动生成并稳定复用。
RUOYI_TOKEN_SECRET=
RUOYI_TOKEN_SECRET_FILE=/var/lib/ruoyi-secrets/token-secret
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_DATABASE=0
SPRING_DATA_REDIS_USERNAME=default
SPRING_DATA_REDIS_PASSWORD=
# 远程 Redis 使用 TLS 时设为 true，并在系统信任库中安装批准的 CA。
SPRING_DATA_REDIS_SSL_ENABLED=false
DRUID_MONITOR_USERNAME=ruoyi
DRUID_MONITOR_PASSWORD=
DRUID_MONITOR_ENABLED=false
RUOYI_LOG_PATH=/var/lib/ruoyi/logs
RUOYI_PROFILE=/var/lib/ruoyi/uploadPath
RUOYI_MANAGEMENT_PORT=18080
# 只有已配置并要求探测真实 SMTP 时才开启，默认通知失败由持久化 outbox 补偿处理。
APPROVAPLAT_SMTP_HEALTH_ENABLED=false
# 普通审批邮件通过真实 SMTP 投递；用户名、密码和 From 地址必须由部署密钥或受控环境填写。
APPROVAPLAT_SMTP_HOST=
APPROVAPLAT_SMTP_PORT=587
APPROVAPLAT_SMTP_USERNAME=
APPROVAPLAT_SMTP_PASSWORD=
APPROVAPLAT_SMTP_AUTH=true
APPROVAPLAT_SMTP_STARTTLS=true
APPROVAPLAT_SMTP_CONNECT_TIMEOUT=5000
APPROVAPLAT_SMTP_READ_TIMEOUT=10000
APPROVAPLAT_SMTP_WRITE_TIMEOUT=10000
APPROVAPLAT_NOTIFICATION_MAIL_FROM=
# 通知 worker 使用数据库租约消费正式 outbox；以下值控制批量、租约、重试和催办节流。
APPROVAPLAT_NOTIFICATION_WORKER_ENABLED=true
APPROVAPLAT_NOTIFICATION_BATCH_SIZE=50
APPROVAPLAT_NOTIFICATION_LEASE_DURATION=2m
APPROVAPLAT_NOTIFICATION_MAX_RETRY_DELAY=30m
APPROVAPLAT_NOTIFICATION_URGE_INTERVAL=5m
APPROVAPLAT_NOTIFICATION_WORKER_DELAY=1000
# 生产运行拓扑和容量引用均为非敏感值，但必须替换为本次真实批准结果。
FLOWABLE_RUNTIME_DEPLOYMENT_TOPOLOGY=SINGLE_NODE
FLOWABLE_RUNTIME_EXECUTOR_TOPOLOGY=DISABLED
FLOWABLE_RUNTIME_NODE_ID=workflow-node-01
FLOWABLE_RUNTIME_APPROVAL_REFERENCE=
FLOWABLE_RUNTIME_CAPACITY_APPROVAL_REFERENCE=
FLOWABLE_ASYNC_EXECUTOR_ACTIVATE=false
FLOWABLE_ASYNC_HISTORY_EXECUTOR_ACTIVATE=false
# 全局关闭仅用于测试、迁移或维护环境；需要正常 readiness 和后台处理的生产节点必须保持 true。
FLOWABLE_SCHEDULING_ENABLED=true
# 工作流调度池大小是非敏感容量参数，默认按当前五个独立 fixedDelay 任务配置。
FLOWABLE_SCHEDULING_POOL_SIZE=5
FLOWABLE_ATTACHMENT_STORAGE_MODE=LOCAL_PERSISTENT
# SHARED_FILESYSTEM 模式必须填写预置 .storage-id 的真实值；本地持久卷保持为空。
FLOWABLE_ATTACHMENT_STORAGE_ID=
FLOWABLE_ATTACHMENT_MAX_SIZE=52428800
FLOWABLE_ATTACHMENT_MAX_TEMPORARY_COUNT=100
FLOWABLE_ATTACHMENT_MAX_TEMPORARY_BYTES=536870912
FLOWABLE_ATTACHMENT_MIN_FREE_BYTES=1073741824
FLOWABLE_ATTACHMENT_CLEANUP_BATCH_SIZE=100
FLOWABLE_ATTACHMENT_CLEANUP_LEASE_DURATION=PT5M
FLOWABLE_ATTACHMENT_CLEANUP_RETRY_INITIAL_DELAY=PT1M
FLOWABLE_ATTACHMENT_CLEANUP_RETRY_MAX_DELAY=PT6H
FLOWABLE_ATTACHMENT_CLEANUP_INITIAL_DELAY=PT1M
FLOWABLE_ATTACHMENT_CLEANUP_FIXED_DELAY=PT10M
# 工作流生命周期任务只删除明确终态历史；未读、待处理和死信数据不自动删除。
FLOWABLE_DATA_RETENTION_BATCH_SIZE=100
FLOWABLE_NOTIFICATION_OUTBOX_RETENTION=P90D
FLOWABLE_RUNTIME_EVENT_RETENTION=P90D
FLOWABLE_PROCESS_DRAFT_RETENTION=P30D
FLOWABLE_COLLABORATION_RETENTION=P90D
FLOWABLE_ATTACHMENT_METADATA_RETENTION=P90D
FLOWABLE_NOTIFICATION_INBOX_RETENTION=P180D
FLOWABLE_BPMN_EVENT_AUDIT_RETENTION=P180D
FLOWABLE_TASK_SLA_RETENTION=P180D
FLOWABLE_COPY_RETENTION=P180D
FLOWABLE_CONTROLLED_LOOP_RETENTION=P180D
FLOWABLE_MULTI_INSTANCE_ROUND_RETENTION=P180D
FLOWABLE_DATA_RETENTION_INITIAL_DELAY=PT5M
FLOWABLE_DATA_RETENTION_FIXED_DELAY=PT1H
FLOWABLE_RUNTIME_METRICS_REFRESH_INITIAL_DELAY=PT10S
FLOWABLE_RUNTIME_METRICS_REFRESH_INTERVAL=PT1M
FLOWABLE_RUNTIME_METRICS_SNAPSHOT_MAX_AGE=PT3M
